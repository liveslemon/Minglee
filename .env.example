PORT=4000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
JWT_SECRET=change_me_to_a_long_random_string
# Private bucket (see migrations/004_private_photos.sql); photos are served via signed URLs.
SUPABASE_USER_PHOTOS_BUCKET=user-photos
# Public bucket for ad images. Must NOT be the user photos bucket.
SUPABASE_ADS_BUCKET=ad-images
BACKEND_URL=https://your-backend-service.onrender.com
NODE_ENV=production
# Comma-separated browser origins allowed to call the API (exact scheme+host[+port], no trailing slash or path).
# Required when NODE_ENV=production: the server refuses to start without it.
# Outside production, http://localhost:* and http://127.0.0.1:* are also allowed.
CORS_ORIGINS=https://your-frontend.example.com
ADMIN_SECRET=change_me_to_a_long_random_string
# Payments: set the key(s) for the gateway(s) you use. Without a key, that gateway is disabled.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Local dev only: fake a successful gateway. Ignored when NODE_ENV=production.
PAYMENTS_MOCK_MODE=false
